
methods: {
  getFile(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;

    const reader = new FileReader();

    reader.onload = (event) => {
      const img = new Image();

      img.onload = async () => {
        try {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');

          // 1. 圖片尺寸限制
          const maxSize = 950;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > maxSize) {
              height *= maxSize / width;
              width = maxSize;
            }
          } else {
            if (height > maxSize) {
              width *= maxSize / height;
              height = maxSize;
            }
          }

          width = Math.round(width);
          height = Math.round(height);

          canvas.width = width;
          canvas.height = height;

          // 2. 繪製原始圖片
          ctx.drawImage(img, 0, 0, width, height);

          // 3. 加入浮水印
          await this.addWatermark(canvas);

          // 4. 保留原本的 JPG 壓縮規格
          this.inputVal = canvas.toDataURL('image/jpeg', 0.5);

          // 5. 通知父元件
          this.$emit('input', this.inputVal);

        } catch (error) {
          console.error('圖片處理失敗:', error);
        }
      };

      img.onerror = () => {
        console.error('圖片載入失敗');
      };

      img.src = event.target.result;
    };

    reader.onerror = () => {
      console.error('檔案讀取失敗');
    };

    reader.readAsDataURL(file);
  },

  async addWatermark(canvas) {
    const ctx = canvas.getContext('2d');

    const width = canvas.width;
    const height = canvas.height;

    const watermark = 'XXXXXXX用';
    const fontFamily = 'TW-MOE-Std-Kai';
    const fontColor = 'rgba(128, 128, 128, 0.5)';

    // 1. 計算浮水印角度及圖片對角線
    const angle = -Math.atan2(height, width);
    const diagonal = Math.hypot(width, height);

    // 2. 等待字型載入
    await document.fonts.load(
      `bold 24px "${fontFamily}"`,
      watermark
    );

    // 3. 計算浮水印字體大小
    let fontSize = Math.min(width, height) * 0.15;

    ctx.font = `bold ${fontSize}px "${fontFamily}"`;

    const textWidth = ctx.measureText(watermark).width;
    const targetWidth = diagonal * 0.85;

    if (textWidth > 0) {
      fontSize *= targetWidth / textWidth;
    }

    // 保留目前的字體比例上限
    fontSize = Math.min(
      fontSize,
      diagonal * 0.075
    );

    const fontSpec = `bold ${fontSize}px "${fontFamily}"`;

    // 4. 建立獨立 Canvas，專門繪製文字
    const textCanvas = document.createElement('canvas');
    const textCtx = textCanvas.getContext('2d');

    const scale = 2;

    // 先測量文字範圍
    textCtx.font = fontSpec;

    const metrics = textCtx.measureText(watermark);

    const textWidthPx = Math.ceil(
      metrics.width + fontSize * 2
    );

    const textHeightPx = Math.ceil(fontSize * 3);

    // 使用 2 倍解析度繪製
    textCanvas.width = Math.ceil(textWidthPx * scale);
    textCanvas.height = Math.ceil(textHeightPx * scale);

    textCtx.scale(scale, scale);

    // 設定文字樣式
    textCtx.font = fontSpec;
    textCtx.fillStyle = fontColor;
    textCtx.textAlign = 'center';
    textCtx.textBaseline = 'middle';

    // 5. 先繪製未旋轉的文字
    textCtx.fillText(
      watermark,
      textWidthPx / 2,
      textHeightPx / 2
    );

    // 6. 將文字旋轉後合成到圖片
    ctx.save();

    ctx.translate(width / 2, height / 2);
    ctx.rotate(angle);

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';

    ctx.drawImage(
      textCanvas,
      -textWidthPx / 2,
      -textHeightPx / 2,
      textWidthPx,
      textHeightPx
    );

    ctx.restore();
  }
}
